{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.13",
        "-m",
        "http.server",
        "8777",
        "--directory",
        "docs"
      ],
      "port": 8777
    },
    {
      "name": "camper-neu",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.13",
        "camper.py",
        "serve",
        "--kein-browser"
      ],
      "port": 8765
    },
    {
      "name": "camper-serve",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-3.13",
        "camper.py",
        "serve",
        "--alt",
        "--kein-browser",
        "--port",
        "8766"
      ],
      "port": 8766
    }
  ]
}
