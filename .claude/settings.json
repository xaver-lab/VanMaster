{
  "permissions": {
    "deny": [
      "Read(./docs/data.json)",
      "Read(./docs/data.js)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/push_wache.py",
            "timeout": 60,
            "statusMessage": "Push-Wache"
          }
        ]
      }
    ]
  }
}
